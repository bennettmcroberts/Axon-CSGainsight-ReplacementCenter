# Copy this file to ".env" in the same folder and fill in what you need.

# "mock" (default) uses a realistic, self-contained synthetic dataset.
# "salesforce" connects to your real Axon Salesforce org using the credentials below.
# "hybrid" routes each query to whichever of Salesforce/Snowflake actually has
# that data - see NOTES.md for exactly which query shapes go where, and which
# ones are still gaps (no real source exists for them yet).
DATA_MODE=mock

# Needed for DATA_MODE=salesforce or DATA_MODE=hybrid.
# Uses simple-salesforce's SOAP username/password/security-token login -
# no Connected App required. Get a security token from Salesforce:
# Setup (your avatar) > Settings > My Personal Information > Reset My Security Token.
SF_USERNAME=
SF_PASSWORD=
SF_SECURITY_TOKEN=

# "login" for production orgs, "test" for sandboxes, or your My Domain prefix
# (e.g. "axon--sandboxname" for a My Domain login URL like
# https://axon--sandboxname.sandbox.my.salesforce.com).
SF_DOMAIN=login

# Needed for DATA_MODE=hybrid (reads the MART_CUSTOMER_SUCCESS_PROD dbt mart).
# SNOWFLAKE_ACCOUNT is your account identifier (e.g. "xy12345.us-east-1").
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=MART_CUSTOMER_SUCCESS_PROD

# Mock data tuning (optional).
MOCK_SEED=42
MOCK_ACCOUNT_COUNT=64

# Port the backend listens on.
PORT=8420

# Signs login session cookies. Set this to a long random string so logins
# survive a server restart (otherwise a random one is generated each run and
# everyone gets logged out). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
